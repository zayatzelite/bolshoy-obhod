extends SceneTree
func _initialize() -> void:
	var progress = preload("res://scripts/progression.gd").new()
	var cfg := ConfigFile.new()
	cfg.set_value("progress","xp","broken")
	cfg.set_value("progress","spent",NAN)
	cfg.set_value("upgrades","cart",999)
	cfg.set_value("upgrades","stamina",null)
	cfg.set_value("upgrades","boots",-4)
	progress.apply_loaded_values(cfg)
	assert(progress.xp==0 and progress.spent==3)
	assert(progress.capacity()==10 and progress.ranks.stamina==0 and progress.ranks.boots==0)
	assert(progress.points()==0)
	cfg.set_value("progress","xp",600)
	cfg.set_value("progress","spent",3)
	cfg.set_value("upgrades","cart",1)
	progress.apply_loaded_values(cfg)
	assert(progress.points()==3 and progress.capacity()==6)
	print("PROGRESS VALIDATION PASS: malformed types rejected, ranks bounded, valid points preserved; user file untouched")
	quit()
