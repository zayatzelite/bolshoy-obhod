extends SceneTree
func _initialize() -> void:call_deferred("run")
func run() -> void:
	var world=load("res://scenes/world.tscn").instantiate()
	root.add_child(world)
	assert(world.plant_catalog.entries.size()==21,str(world.plant_catalog.errors))
	var plants=world.find_children("ProtectedPlant*","Node3D",true,false)
	assert(plants.size()==21)
	world.observed_species.clear()
	var body:StaticBody3D=plants[0].get_child(1)
	for plant in plants:
		var hitbox=plant.get_child(1).get_child(0)
		assert(hitbox.shape is BoxShape3D and hitbox.shape.size.y>.4)
	world.focused_species=str(body.get_meta("species_id"))
	world.interact()
	assert(world.observed_species.size()==1)
	assert(is_instance_valid(world.overlay))
	world.overlay.free();world.resume()
	world.pickup(body);world.pickup(body)
	assert(world.conservation_warnings==1 and world.conservation_penalty==25)
	world.player.set_physics_process(false)
	world.player.position=plants[0].position+Vector3(0,.1,1.4)
	await create_timer(.4).timeout
	world.player.camera.look_at(body.global_position+Vector3(0,.3,0),Vector3.UP)
	world.update_focus()
	assert(world.focused_species=="park-01","Camera ray failed to identify nearby plant")
	var recognition_shape=body.get_child(0)
	world.player.camera.look_at(body.global_position+recognition_shape.position+Vector3(0,recognition_shape.shape.size.y*.4,0),Vector3.UP)
	world.update_focus()
	assert(world.focused_species=="park-01","Flower-top ray failed")
	world.photo_manifest="user://playable_plants_photo_test.json"
	world.photo_records.clear()
	world.player.toggle_camera()
	await create_timer(.3).timeout
	world.player.set_process(false)
	world.player.photo_camera.hide()
	world.player.camera.look_at(body.global_position+Vector3(0,.3,0),Vector3.UP)
	await world.take_photo()
	assert(world.photo_records.size()==1 and world.photo_records[0].species=="park-01")
	world.observed_species.clear()
	world.load_photo_records()
	assert(world.observed_species.has("park-01"))
	world.player.toggle_camera()
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("C:/Users/zayatz/Downloads/lenskiy stolbi/playable_plants_preview.png")
	print("PLAYABLE PLANTS PASS: 21 validated models spawned, card discovery, collection warning and penalty")
	quit()
